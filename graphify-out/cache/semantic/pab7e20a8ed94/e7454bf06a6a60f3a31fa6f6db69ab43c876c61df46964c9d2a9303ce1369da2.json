{"nodes": [{"id": "apps_web_img_f_bank_mascot_character", "label": "F Bank Mascot Character", "file_type": "image", "source_file": "apps/web/img/f-bank-mascot.gif", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full-body anthropomorphic brand mascot for F Bank: a smiling shield-headed figure in matching green streetwear, isolated on white with a soft drop shadow. Delivered as a GIF89a (~357x358) web asset so the character can sit in product UI as an animated, approachable face of the bank rather than a static logo."}, {"id": "apps_web_img_f_bank_mascot_f_bank", "label": "F Bank", "file_type": "concept", "source_file": "apps/web/img/f-bank-mascot.gif", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Named brand on the hoodie chest lockup. The mascot exists to personify this bank as friendly, youthful, and trustworthy."}, {"id": "apps_web_img_f_bank_mascot_shield_head", "label": "Two-Tone Shield Head", "file_type": "image", "source_file": "apps/web/img/f-bank-mascot.gif", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The head is a heraldic shield split vertically: mint/light green on the left, forest green on the right, with large cartoon eyes, simple black brows, and a small smile. No hair, ears, or nose. The shield-as-face is the character's defining silhouette."}, {"id": "apps_web_img_f_bank_mascot_f_logo", "label": "F BANK Chest Lockup", "file_type": "image", "source_file": "apps/web/img/f-bank-mascot.gif", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_web_img_f_bank_mascot_hoodie_uniform", "label": "Green Streetwear Uniform", "file_type": "image", "source_file": "apps/web/img/f-bank-mascot.gif", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dark green pullover hoodie with white drawstrings and white-gloved hands; matching joggers with a white side stripe; white sneakers with green heel/toe caps and a lime F on each tongue. Casual athletic kit, not a suit or bank-teller costume."}, {"id": "apps_web_img_f_bank_mascot_two_tone_green", "label": "Two-Tone Green Palette", "file_type": "image", "source_file": "apps/web/img/f-bank-mascot.gif", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_web_img_f_bank_mascot_cartoon_vector_style", "label": "Cartoon Vector Mascot Style", "file_type": "concept", "source_file": "apps/web/img/f-bank-mascot.gif", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bold black outlines, cel-shaded flats, simplified anatomy, sticker-like isolation on white with an oval ground shadow. Fintech-mascot illustration, not photorealism or a UI screenshot."}, {"id": "apps_web_img_f_bank_mascot_confident_stance", "label": "Hands-on-Hips Stance", "file_type": "image", "source_file": "apps/web/img/f-bank-mascot.gif", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_web_img_f_bank_mascot_security_metaphor", "label": "Banking Shield Metaphor", "file_type": "concept", "source_file": "apps/web/img/f-bank-mascot.gif", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A shield for a head encodes protection and trust \u2014 the visual language of banking security \u2014 while the smile and hoodie keep the same idea from feeling institutional or severe."}], "edges": [{"source": "apps_web_img_f_bank_mascot_character", "target": "apps_web_img_f_bank_mascot_shield_head", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/web/img/f-bank-mascot.gif", "source_location":