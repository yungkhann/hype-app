{"nodes": [{"id": "_claude_skills_impeccable_reference_adapt_adapt_web_playbook", "label": "Adapt web playbook", "file_type": "document", "source_file": ".claude/skills/impeccable/reference/adapt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_impeccable_reference_adapt_rethinking_not_scaling", "label": "Adaptation is rethinking, not scaling", "file_type": "rationale", "source_file": ".claude/skills/impeccable/reference/adapt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The trap is treating adaptation as scaling. The job is rethinking the experience for the new context."}, {"id": "_claude_skills_impeccable_reference_adapt_mobile_first", "label": "Mobile-first responsive design", "file_type": "rationale", "source_file": ".claude/skills/impeccable/reference/adapt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Start with base styles for mobile, use min-width queries to layer complexity. Desktop-first means mobile loads unnecessary styles first."}, {"id": "_claude_skills_impeccable_reference_adapt_content_driven_breakpoints", "label": "Content-driven breakpoints", "file_type": "rationale", "source_file": ".claude/skills/impeccable/reference/adapt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Don't chase device sizes; let content tell you where to break. Three breakpoints usually suffice (640, 768, 1024px)."}, {"id": "_claude_skills_impeccable_reference_adapt_pointer_hover_queries", "label": "Detect input method, not just screen size", "file_type": "rationale", "source_file": ".claude/skills/impeccable/reference/adapt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Screen size does not tell you input method. Use pointer and hover media queries. Don't rely on hover for functionality."}, {"id": "_claude_skills_impeccable_reference_adapt_safe_areas", "label": "Safe areas and viewport-fit", "file_type": "concept", "source_file": ".claude/skills/impeccable/reference/adapt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_impeccable_reference_adapt_responsive_images", "label": "Responsive images", "file_type": "concept", "source_file": ".claude/skills/impeccable/reference/adapt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_impeccable_reference_adapt_custom_control_gestures", "label": "Custom control gesture verification", "file_type": "concept", "source_file": ".claude/skills/impeccable/reference/adapt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Screenshots and resized viewports verify layout, never a gesture. Name what stayed untested; unreachable hardware is a reported gap, not a blocker."}, {"id": "_claude_skills_impeccable_reference_adapt_touch_target_44px", "label": "44x44px touch targets", "file_type": "concept", "source_file": ".claude/skills/impeccable/reference/adapt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "_claude_skills_impeccable_reference_adapt_adapt_web_playbook", "target": "_claude_skills_impeccable_reference_adapt_native_adapt_native_playbook", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/impeccable/reference/adapt.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_impeccable_reference_adapt_rethinking_not_scaling", "target": "_claude_skills_impeccable_skill_command_adapt", "relation": "rationale_for", "confidence": "EXTRACTED",