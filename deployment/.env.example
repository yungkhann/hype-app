# ATLAS CQA - production settings for the Windows host.
# install.ps1 copies this file to C:\hype-cqa\hype.env (outside the repository). Edit THAT copy, never commit it.
# It is read by the deploy scripts and by Docker Compose (--env-file). Tokens do NOT go here: install.ps1 stores
# them encrypted in C:\hype-cqa\secrets.
# Format: KEY=value, one per line. Put values containing & ? % # or spaces in 'single quotes'.

# ---- Release source (GitHub) ----------------------------------------------------------------------------------
GITHUB_REPOSITORY=yungkhann/hype-app
RELEASE_WORKFLOW=release.yml
RELEASE_BRANCH=main
# Images: <IMAGE_PREFIX>-web:<sha> and <IMAGE_PREFIX>-api:<sha> (lowercase).
IMAGE_PREFIX=ghcr.io/yungkhann/hype-app
# GitHub account that owns the GHCR pull token (token 2).
GHCR_USERNAME=yungkhann

# ---- Website ---------------------------------------------------------------------------------------------------
# The site listens on http://127.0.0.1:WEB_PORT only (Cloudflare Tunnel's origin; not reachable from the LAN).
WEB_PORT=3000
# Public host name served through Cloudflare Tunnel, without https://. The API refuses other Host headers.
PUBLIC_HOSTNAME=lumvy.io
# API paths the web server forwards. Default: health + CQA only (the data-studio API stays private).
# Use /api/v1/ to forward everything.
API_ALLOWED_PREFIXES=/api/v1/health,/api/v1/cqa/
# true = public visitors can read but not change anything (all API writes refused at the web server).
API_READ_ONLY=false

# ---- AI evaluation model (runs on this Windows PC, outside Docker) ---------------------------------------------
# mock = development mock (NOT AI, labelled in the UI). http = the teammate's model service. See docs/MODEL_INTEGRATION.md.
ATLAS_CQA_EVALUATOR=mock
# From inside Docker, this PC is host.docker.internal. Replace PORT and path with the teammate's real endpoint.
# Example: ATLAS_CQA_EVALUATOR_URL=http://host.docker.internal:9000/evaluate
ATLAS_CQA_EVALUATOR_URL=
# Seconds per conversation before an evaluation fails with "did not answer in time".
ATLAS_CQA_EVALUATOR_TIMEOUT_S=180
# Conversations evaluated in parallel (keep low for a single local GPU).
ATLAS_CQA_EVALUATION_WORKERS=1
# Optional: a URL the health check probes instead of the evaluate URL (e.g. http://host.docker.internal:9000/health).
MODEL_HEALTH_URL=
# Ollama's own API (informational check in healthcheck.ps1 only; ATLAS never calls Ollama directly).
OLLAMA_URL=http://127.0.0.1:11434

# ---- Conversation source (organizers' API) ---------------------------------------------------------------------
# The organizers' signed GET URL, WITHOUT group_id, in single quotes. Secret: decide deliberately whether this PC
# should have it. Empty = imports from the organizers' API are disabled (synthetic FIXTURE data still works).
ATLAS_CQA_SOURCE_URL=
ATLAS_CQA_FIXTURES_ENABLED=true

# ---- Deployment agent ------------------------------------------------------------------------------------------
# Seconds docker compose waits for both containers to become healthy.
DEPLOY_HEALTH_TIMEOUT_S=240
# A release that fails this many times is skipped until a newer one appears (retries after 5, 10 minutes).
MAX_ATTEMPTS_PER_RELEASE=3
# Data snapshots kept per kind (before each deployment / every 6 hours).
BACKUP_KEEP=20
LOG_KEEP_DAYS=14
# Release images kept on disk besides the current and previous release.
IMAGES_KEEP=3
