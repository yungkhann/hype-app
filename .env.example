# Copy to .env (git-ignored) to override defaults. scripts/dev.sh loads it for both services.
# Everything stays on this machine: both servers bind to 127.0.0.1 only.

# Ports (change if 3000/8000 are taken by another project).
ATLAS_WEB_PORT=3000
ATLAS_API_PORT=8000

# Where uploaded datasets, findings, and experiments are stored (git-ignored).
# ATLAS_DATA_DIR=/absolute/path/to/workspaces

# Limits
ATLAS_MAX_UPLOAD_MB=500
# Largest size an .xlsx may expand to when unzipped (zip-bomb guard), in MB.
# ATLAS_MAX_UNCOMPRESSED_MB=4096
# ATLAS_MAX_ROWS=5000000
# ATLAS_PROFILE_SAMPLE_ROWS=200000
# ATLAS_MODEL_MAX_TRAIN_ROWS=200000
# ATLAS_MODEL_WORKERS=2

# Network. List values are JSON inside single quotes (dev.sh sources this file with bash, which would
# otherwise strip the double quotes).
# Host headers the API accepts; ports are ignored. Blocks DNS rebinding.
# ATLAS_ALLOWED_HOSTS='["127.0.0.1","localhost"]'
# Browser origins allowed to call the API. scripts/dev.sh derives this from ATLAS_WEB_PORT when unset.
# ATLAS_CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'
